APP_NAME="PolicyPilot RAG Studio"

MODEL_PROVIDER=ollama
OLLAMA_MODEL=llama3.2:3b

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

VECTOR_STORE=chroma
VECTOR_STORE_PATH=.cache/chroma

DEFAULT_TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=120

ENABLE_DEBUG_VIEW=true
ENABLE_AZURE_MODE=false
ENABLE_GITHUB_MODELS=false

EVAL_MAX_QUESTIONS=20